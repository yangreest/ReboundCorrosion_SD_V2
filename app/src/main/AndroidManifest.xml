<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 相机功能 -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!-- ============================================ -->
    <!-- 蓝牙相关权限 -->
    <!-- ============================================ -->
    <!-- Android 11 及以下的蓝牙权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Android 12+ 的新蓝牙权限 -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 位置权限（蓝牙扫描需要，Android 12 以下必须） -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- ============================================ -->
    <!-- 存储权限 -->
    <!-- ============================================ -->
    <!-- Android 10 及以下的存储权限 -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 11+ 所有文件访问权限 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- ============================================ -->
    <!-- 相机权限 -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- ============================================ -->
    <!-- 网络权限 -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ============================================ -->
    <!-- 硬件与系统权限 -->
    <!-- ============================================ -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission
        android:name="android.permission.REQUEST_INSTALL_PACKAGES"
        tools:ignore="RequestInstallPackagesPolicy" />

    <!-- ============================================ -->
    <!-- 特殊权限 -->
    <!-- ============================================ -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:name=".GTJApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/icon_logo_lrd"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/icon_logo_lrd"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        tools:ignore="DiscouragedApi"
        tools:targetApi="31">
        <activity
            android:name=".base.activity.MainActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!--HOME桌面特性-->
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".base.activity.detect.DetectionActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".base.activity.data.DataManagerActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.data.DataDetailsActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.data.DataExportDataActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.setting.SettingActivity"
            android:screenOrientation="landscape" />

        <activity
            android:name=".f230.activity.testing.width.WidthDetectActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".f230.activity.setting.WifiListActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".f230.activity.setting.CalibrationWidthActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.CrashMessageActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".rebound.activity.testing.ModifyTestDataActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.detect.NewProjectActivity"
            android:theme="@style/MyDialog"
            android:windowSoftInputMode="adjustPan|stateHidden" />
        <activity
            android:name=".rebound.activity.testing.RebounderDetectActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".rebound.activity.setting.BluetoothPrinterActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".rebound.activity.setting.InstrumentCalibrationActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CorrosionDetectActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CorrosionDetectActivity1"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.setting.ScanningBluetoothActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.setting.CalibrationDeviceActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.setting.MeteringDeviceActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationCurveActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationCurveActivity1"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationCurveActivity2"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationCurveListActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationCurveListActivity1"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CalibrationMinMaxListActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".corrosion.activity.testing.CorrosionDetectActivity2"
            android:screenOrientation="landscape" />
        <activity
            android:name=".thickness.activity.DetectActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".thickness.activity.ConfigListActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".thickness.activity.ConfigManagerActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".thickness.activity.DetectConfigActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".base.activity.data.DataExportThicknessActivity"
            android:screenOrientation="landscape" />

        <!--APP升级-->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <receiver
            android:name=".f230.activity.receiver.WifiBroadcastReceiver"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.CONFIGURATION_CHANGED" />
                <action android:name="android.net.wifi.WIFI_STATE_CHANGED" />
                <action android:name="android.net.wifi.STATE_CHANGE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>