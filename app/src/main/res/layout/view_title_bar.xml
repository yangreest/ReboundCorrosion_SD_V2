<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="50dp"
    android:background="@color/theme_color">

    <LinearLayout
        android:id="@+id/layout_logo"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginLeft="13dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_logo_gtj"
            android:layout_width="141.1dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_logo_white_gtj" />

        <ImageView
            android:id="@+id/iv_logo_lrd"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:padding="4dp"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_logo_white_lrd" />

        <ImageView
            android:id="@+id/iv_logo_zhi"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_logo_white_zhi" />

        <View
            android:id="@+id/v_center"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:background="@color/colorFFF"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_logo_gjdw"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerCrop"
            android:src="@mipmap/icon_logo_white_gjdw"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_logo_mshz"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_logo_white_mshz"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_n_project"
        android:layout_width="104dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="13dp"
        android:layout_toEndOf="@+id/layout_logo"
        android:background="@drawable/bg_edittext1"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@color/colorFFB610"
            android:gravity="center_vertical"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:text="P"
            android:textColor="@color/color000"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/tv_n_project"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingLeft="2dp"
            android:paddingRight="3dp"
            android:singleLine="true"
            android:textColor="@color/color000"
            android:textSize="22dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_n_zone"
        android:layout_width="104dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/layout_n_project"
        android:background="@drawable/bg_edittext1"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_margin="1dp"
            android:background="@color/colorFFB610"
            android:gravity="center"
            android:paddingLeft="3dp"
            android:paddingRight="3dp"
            android:text="N"
            android:textColor="@color/color000"
            android:textSize="22dp" />

        <TextView
            android:id="@+id/tv_n_zone"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:paddingLeft="2dp"
            android:paddingRight="3dp"
            android:singleLine="true"
            android:textColor="@color/color000"
            android:textSize="22dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_navTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:textColor="@color/colorFFF"
        android:textSize="24dp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_cor_bluetooth"
        android:layout_width="18dp"
        android:layout_height="26dp"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/tv_cor_ble"
        android:src="@mipmap/icon_bluetooth" />

    <TextView
        android:id="@+id/tv_cor_ble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/iv_cor_bluetooth"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="-2dp"
        android:layout_toLeftOf="@+id/iv_rebound_bluetooth"
        android:text="X"
        android:textColor="@color/colorFFF"
        android:textSize="16dp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_rebound_bluetooth"
        android:layout_width="18dp"
        android:layout_height="26dp"
        android:layout_centerVertical="true"
        android:layout_toLeftOf="@+id/tv_rebound_ble"
        android:src="@mipmap/icon_bluetooth" />

    <TextView
        android:id="@+id/tv_rebound_ble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBottom="@id/iv_rebound_bluetooth"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="13dp"
        android:layout_marginBottom="-2dp"
        android:layout_toLeftOf="@+id/iv_f230"
        android:text="H"
        android:textColor="@color/colorFFF"
        android:textSize="16dp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_f230"
        android:layout_width="34dp"
        android:layout_height="26dp"
        android:layout_centerVertical="true"
        android:layout_marginRight="13dp"
        android:layout_toLeftOf="@+id/tc_time"
        android:src="@mipmap/icon_wifi" />

    <TextClock
        android:id="@+id/tc_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginRight="10dp"
        android:layout_toLeftOf="@+id/layout_1"
        android:format12Hour="yyyy-MM-dd HH:mm:ss"
        android:format24Hour="yyyy-MM-dd HH:mm:ss"
        android:textColor="@color/colorFFF"
        android:textSize="22dp" />

    <RelativeLayout
        android:id="@+id/layout_1"
        android:layout_width="50dp"
        android:layout_height="match_parent"
        android:layout_alignParentRight="true"
        android:layout_marginRight="13dp">

        <View
            android:id="@+id/iv_battery_level"
            android:layout_width="48dp"
            android:layout_height="25dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="2dp"
            android:background="@color/color00D441" />

        <ImageView
            android:id="@+id/iv_battery"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@mipmap/icon_battery" />

        <TextView
            android:id="@+id/tv_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:textColor="@color/colorFFF"
            android:textSize="20dp" />
    </RelativeLayout>
</RelativeLayout>