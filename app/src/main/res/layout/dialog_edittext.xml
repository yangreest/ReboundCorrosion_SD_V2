<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="450dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_fillet"
        android:orientation="vertical">

        <EditText
            android:id="@+id/edittext"
            android:layout_width="200dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@color/colorEEE"
            android:inputType="numberDecimal|numberSigned"
            android:maxLength="20"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:singleLine="true"
            android:textColor="@color/color000"
            android:textColorHint="@color/color999"
            android:textCursorDrawable="@null"
            android:textSize="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="30dp"
            android:background="#BABABA" />

        <LinearLayout
            android:id="@+id/layout_bottom"
            android:layout_width="match_parent"
            android:layout_height="55dp">

            <Button
                android:id="@+id/btn_dialog_left"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_dialog_left_selector"
                android:text="取消"
                android:textColor="@drawable/btn_dialog_text_selector"
                android:textSize="20dp" />

            <TextView
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#BABABA" />

            <Button
                android:id="@+id/btn_dialog_right"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/btn_dialog_right_selector"
                android:text="确定"
                android:textColor="@drawable/btn_dialog_text_selector"
                android:textSize="20dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>