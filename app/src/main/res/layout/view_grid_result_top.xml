<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:layout_width="90dp"
            android:layout_height="match_parent"
            android:background="@color/color006F5F">

            <com.example.gtj_f230_rebound_corrosion.corrosion.view.DiagonalLineView
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentRight="true"
                android:lineSpacingExtra="-4dp"
                android:padding="2dp"
                android:text="检测\n次数"
                android:textColor="@color/colorFFF"
                android:textSize="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:lineSpacingExtra="-4dp"
                android:padding="2dp"
                android:text="测点\n位置"
                android:textColor="@color/colorFFF"
                android:textSize="16dp" />

            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:background="@color/color8E8E8E" />

            <View
                android:id="@+id/v_c"
                android:layout_width="1px"
                android:layout_height="1px"
                android:layout_centerVertical="true" />

            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_above="@+id/v_c"
                android:layout_alignParentRight="true"
                android:background="@color/color8E8E8E" />

            <View
                android:layout_width="1px"
                android:layout_height="match_parent"
                android:layout_below="@+id/v_c"
                android:layout_alignParentRight="true"
                android:background="@color/color8E8E8E" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/color006F5F"
                android:gravity="center"
                android:text="保护层厚度（单位：mm）"
                android:textColor="@color/colorFFF"
                android:textSize="20dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1px"
                android:background="@color/color8E8E8E" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/colorD8D8D8"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_grid_1"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_1"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_2"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_2"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_3"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_3"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_4"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="4"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_4"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_5"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="5"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_5"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_6"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="6"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_6"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_7"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="7"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_7"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_8"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="8"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_8"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_9"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="9"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_9"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_10"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="10"
                    android:textColor="@color/color006F5F"
                    android:textSize="20dp"
                    android:visibility="gone" />

                <View
                    android:id="@+id/v_grid_10"
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_grid_average"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:lineSpacingExtra="-6dp"
                    android:text="平均\n厚度"
                    android:textColor="@color/color006F5F"
                    android:textSize="18dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="1px"
                    android:layout_height="match_parent"
                    android:background="@color/color8E8E8E" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/color8E8E8E" />
</LinearLayout>