<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:bottom="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#00796A" />
        </shape>
    </item>

    <item
        android:height="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#01A994"
                android:startColor="#00796A" />
            <corners android:topRightRadius="3dp"/>
        </shape>
    </item>

    <item
        android:gravity="bottom"
        android:height="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00796A"
                android:startColor="#005248" />
            <corners android:bottomRightRadius="3dp"/>
        </shape>
    </item>

</layer-list>