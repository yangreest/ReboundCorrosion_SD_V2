<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:bottom="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="#CC00796A" />
        </shape>
    </item>

    <item android:height="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#CC01A994"
                android:startColor="#CC00796A" />
            <corners
                android:topLeftRadius="5dp"
                android:topRightRadius="5dp" />
        </shape>
    </item>

    <item
        android:height="5dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#CC00796A"
                android:startColor="#CC005248" />
            <corners
                android:bottomLeftRadius="5dp"
                android:bottomRightRadius="5dp" />
        </shape>
    </item>

</layer-list>